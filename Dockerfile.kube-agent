# AX Task image packaging the kube-agents Hermes agent runtime, Cluster/Platform
# GKE skills, diagnostic CLIs (kubectl, yq, helm, leeway, tirith, jq), and
# ax-task-runner as PID 1.
ARG SANDBOX_IMAGE=us-central1-docker.pkg.dev/agentic-harness-demo/demo/agent-sandbox:kube-proxy-1793830865
ARG AGENT_BASE_IMAGE=us-central1-docker.pkg.dev/agentic-harness-demo/demo/platform-agent:pr3639-17184537

FROM ${SANDBOX_IMAGE} AS sandbox-tools

FROM ${AGENT_BASE_IMAGE}

USER root

# Copy stock kubectl (1.35.10), yq, helm, and leeway into /usr/local/bin so
# Hermes local terminal commands reach k8s-api-proxy directly via KUBECONFIG=/ax/kubeconfig.
COPY --from=sandbox-tools /usr/local/libexec/kubectl /usr/local/bin/kubectl
COPY --from=sandbox-tools /usr/local/bin/yq /usr/local/bin/yq
COPY --from=sandbox-tools /usr/local/bin/helm /usr/local/bin/helm
COPY --from=sandbox-tools /usr/local/bin/leeway /usr/local/bin/leeway

# Pre-scaffold /root/.hermes with the Cluster Agent persona, SOUL.md, AGENTS.md,
# and all cluster + platform skills, configured to execute commands locally inside
# the AX gVisor sandbox and route LLM calls through inference-gateway.
RUN mkdir -p /root/.hermes/skills /root/.hermes/logs /root/.hermes/sessions && \
    cp -r /opt/cluster-template/SOUL.md /opt/cluster-template/AGENTS.md /opt/cluster-template/CAPABILITIES.md /opt/cluster-template/persona /root/.hermes/ && \
    cp -r /opt/cluster-template/skills/* /root/.hermes/skills/ && \
    cp -rn /opt/platform-template/skills/* /root/.hermes/skills/ 2>/dev/null || true && \
    cat <<'EOF' > /root/.hermes/config.yaml
model:
  provider: custom
  model: model-default
  default: model-default
  base_url: http://inference-gateway.kubeagents-system.svc.cluster.local/v1
  api_key: dummy
  api_mode: chat_completions

providers:
  custom:
    stale_timeout_seconds: 120
    request_timeout_seconds: 300

terminal:
  backend: local
  workspace_root: /workspace

platform_toolsets:
  cli:
    - hermes-cli
  api_server:
    - hermes-api-server

memory:
  memory_enabled: false
  user_profile_enabled: false

agent:
  environment_probe: false
  disabled_toolsets:
    - browser
    - computer_use
    - image_gen
    - tts
    - vision

context_file_max_chars: 100000

auxiliary:
  title_generation:
    enabled: false
EOF

ENV HOME=/root \
    HERMES_HOME=/root/.hermes \
    HERMES_DOCKER_EXEC_AS_ROOT=1 \
    OPENAI_BASE_URL=http://inference-gateway.kubeagents-system.svc.cluster.local/v1 \
    OPENAI_API_KEY=dummy \
    PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

ARG TARGETARCH=amd64
COPY bin/linux_${TARGETARCH}/ax-task-runner /usr/local/bin/ax-task-runner

ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
